<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Release: ABook is offline-only (PROMPT §1). Remove network permissions that any
       library manifest might merge in, so the shipped app cannot reach the network. -->
  <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" tools:node="remove" />
</manifest>
