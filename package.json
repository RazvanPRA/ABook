{
  "name": "abook",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "emu": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/scripts/run-android.ps1",
    "emu:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/scripts/run-android.ps1 -ForceBuild -ResetCache",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "pdf:webview": "node scripts/build-pdf-webview.js",
    "dev:pdfs": "node scripts/make-dev-pdfs.js",
    "postinstall": "npm run pdf:webview",
    "check": "npm run pdf:webview && npm run typecheck && npm run lint && npm run format:check && npm run test -- --coverage"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.41.0",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-documents/picker": "12.1.0",
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@reduxjs/toolkit": "2.15.0",
    "@shopify/flash-list": "2.3.3",
    "i18next": "27.2.1",
    "lucide-react-native": "1.75.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.0",
    "react-i18next": "18.0.2",
    "react-native": "0.88.1",
    "react-native-bootsplash": "7.3.5",
    "react-native-gesture-handler": "3.5.0",
    "react-native-get-random-values": "2.1.0",
    "react-native-reanimated": "4.7.2",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-share": "12.3.1",
    "react-native-svg": "15.16.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "react-redux": "9.3.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "7.29.14",
    "@babel/runtime": "7.29.14",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-import": "2.32.0",
    "jest": "29.7.0",
    "prettier": "3.10.1",
    "react-native-asset": "2.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "AbookSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.abook.specs"
    },
    "ios": {
      "modulesProvider": {
        "AbookTts": "AbookTts"
      }
    }
  }
}
